  <key>CFBundleName</key><string>Phaedrus</string>
  <key>CFBundleDisplayName</key><string>Phaedrus</string>
  <key>CFBundleExecutable</key><string>Phaedrus</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>CFBundleVersion</key><string>1</string>
